<Window x:Class="MineServers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:MineServers.Tabs"
        Title="MineServers" Width="1100" Height="720" MinWidth="800" MinHeight="500"
        Background="#F3F4F6" WindowStartupLocation="CenterScreen" Closing="OnClosing" StateChanged="Window_StateChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Server list -->
        <DockPanel Background="#1F2937">
            <TextBlock DockPanel.Dock="Top" Text="MineServers" Foreground="White" FontSize="22" FontWeight="Bold" Margin="16,16,16,12"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="12">
                <Button Content="+ New server" Style="{StaticResource Primary}" Margin="0,0,0,6" Click="NewServer_Click"/>
                <Button Content="Import from SquidServers" Margin="0,0,0,6" Click="Import_Click"/>
                <Button Content="App settings" Margin="0" Click="AppSettings_Click"/>
            </StackPanel>
            <ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0" Foreground="White"
                     SelectionChanged="ServerList_SelectionChanged" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,6">
                            <TextBlock Text="{Binding Entry.Name}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#555"
                   TextAlignment="Center" Text="No server selected.&#x0a;Make one with &quot;+ New server&quot;, or import your SquidServers servers."/>

        <!-- Selected server -->
        <Grid x:Name="DetailPanel" Grid.Column="1" Margin="20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Content="Start" Style="{StaticResource Primary}" Click="Start_Click"/>
                    <Button x:Name="StopButton" Content="Stop" Click="Stop_Click"/>
                    <Button Content="Open folder" Margin="0" Click="OpenFolder_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="NameText" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="InfoText" Foreground="#555"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12" Margin="0,14,0,10" BorderBrush="#DDD" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Join address:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="ReachButton" DockPanel.Dock="Right" Content="Can friends join?" Margin="8,0,0,0" Click="Reach_Click"
                            ToolTip="Tests the join address from the internet and says plainly whether it works."/>
                    <Button DockPanel.Dock="Right" Content="Copy" Margin="8,0,0,0" Click="Copy_Click"/>
                    <TextBox x:Name="AddressBox" IsReadOnly="True" FontSize="15" FontFamily="Consolas" VerticalContentAlignment="Center" BorderThickness="0"/>
                </DockPanel>
            </Border>

            <TabControl x:Name="Tabs" Grid.Row="2">
                <TabItem Header="Console">
                    <DockPanel Margin="6">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Clear" Margin="6,0,0,0" Click="ClearConsole_Click"/>
                            <Button DockPanel.Dock="Right" Content="Send" Margin="6,0,0,0" Click="Send_Click"/>
                            <TextBox x:Name="CommandBox" FontFamily="Consolas" VerticalContentAlignment="Center" PreviewKeyDown="CommandBox_PreviewKeyDown"
                                     ToolTip="Type a server command (without /) and press Enter, e.g. op YourName. Up and Down go through earlier commands."/>
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Old logs..." Margin="6,0,0,0" Click="OldLogs_Click"
                                    ToolTip="Read the server's earlier log files."/>
                            <TextBlock DockPanel.Dock="Left" Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="FilterBox" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged"
                                     ToolTip="Shows only lines containing this text. Warnings are yellow, errors red. Select lines and press Ctrl+C to copy them."/>
                        </DockPanel>
                        <ListBox x:Name="ConsoleList" FontFamily="Consolas" FontSize="12" Background="#111827" BorderThickness="0" Padding="4"
                                 SelectionMode="Extended" KeyDown="ConsoleList_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Performance">
                    <tabs:PerformanceTab x:Name="PerfTab"/>
                </TabItem>
                <TabItem Header="Players">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,3" Text="Online now"/>
                            <ListBox x:Name="OnlineList" Height="100"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Kick" Click="Kick_Click"/>
                                <Button Content="Make operator" Click="OpOnline_Click"/>
                                <Button Content="Ban" Click="BanOnline_Click"/>
                                <Button Content="Ban IP" Click="BanIpOnline_Click" ToolTip="Bans their internet address, so other accounts from there can't join either."/>
                                <Button Content="Refresh" Click="RefreshOnline_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Game mode" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="GameModeBox" Width="110" SelectedIndex="0">
                                    <ComboBoxItem Content="survival"/>
                                    <ComboBoxItem Content="creative"/>
                                    <ComboBoxItem Content="adventure"/>
                                    <ComboBoxItem Content="spectator"/>
                                </ComboBox>
                                <Button Content="Set" Margin="6,0,16,0" Click="GameMode_Click"/>
                                <TextBlock Text="Teleport to" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="TeleportBox" Width="140"/>
                                <Button Content="Go" Margin="6,0,0,0" Click="Teleport_Click"/>
                            </StackPanel>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Send message" Margin="6,0,0,0" Click="Tell_Click"/>
                                <TextBox x:Name="TellBox" VerticalContentAlignment="Center" ToolTip="A private message to the selected player."/>
                            </DockPanel>

                            <TextBlock Style="{StaticResource Label}" Margin="0,16,0,3" Text="Operators (can use cheats and commands)"/>
                            <ListBox x:Name="OpsList" Height="80"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Make name operator" Click="OpName_Click"/>
                                <Button Content="Remove selected" Click="Deop_Click"/>
                            </StackPanel>

                            <CheckBox x:Name="WhitelistBox" Margin="0,18,0,0" Content="Whitelist: only players I've allowed can join" FontWeight="SemiBold"
                                      Click="WhitelistBox_Click"/>
                            <TextBlock Style="{StaticResource Help}"
                                       Text="When someone who isn't allowed tries to join, MineServers asks whether to let them in. Say yes once and they can always join this server."/>

                            <TextBlock x:Name="PlayersNote" Style="{StaticResource Help}" Foreground="#B45309" Margin="0,10,0,0"
                                       Text="Start the server to add, remove, ban or unban players."/>

                            <TextBlock Style="{StaticResource Label}" Text="Player name"/>
                            <TextBox x:Name="PlayerNameBox" Width="220" HorizontalAlignment="Left"/>

                            <TextBlock Style="{StaticResource Label}" Text="Allowed players (whitelist)"/>
                            <ListBox x:Name="AllowedList" Height="120"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Allow name" Click="AllowPlayer_Click"/>
                                <Button Content="Remove selected" Click="RemoveAllowed_Click"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Label}" Text="Banned players"/>
                            <ListBox x:Name="BannedList" Height="120"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Ban name" Click="BanPlayer_Click"/>
                                <Button Content="Unban selected" Click="Unban_Click"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Label}" Text="Banned internet addresses (IP bans)"/>
                            <ListBox x:Name="BannedIpList" Height="80"/>
                            <Button Content="Unban selected address" HorizontalAlignment="Left" Margin="0,6,0,0" Click="UnbanIp_Click"/>

                            <TextBlock Style="{StaticResource Label}" Text="Everyone who has joined (playtime counted from MineServers 1.5.0)"/>
                            <ListBox x:Name="KnownList" Height="140" FontFamily="Consolas"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="World">
                    <tabs:WorldTab x:Name="WorldTab"/>
                </TabItem>
                <TabItem Header="Scheduler">
                    <tabs:SchedulerTab x:Name="SchedTab"/>
                </TabItem>
                <TabItem x:Name="PluginsItem" Header="Plugins">
                    <tabs:PluginsTab x:Name="PlugTab"/>
                </TabItem>
                <TabItem Header="Tunnels">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,3" Text="Tunnel (how friends outside your Wi-Fi join)"/>
                            <ComboBox x:Name="TunnelBox" SelectionChanged="TunnelBox_SelectionChanged"/>
                            <TextBlock x:Name="TunnelHelp" Style="{StaticResource Help}"/>

                            <StackPanel x:Name="CustomPanel">
                                <TextBlock Style="{StaticResource Label}" Text="Custom tunnel command"/>
                                <TextBox x:Name="CustomCommandBox" FontFamily="Consolas"/>
                                <TextBlock Style="{StaticResource Help}" Text="Example: C:\Tools\mytunnel.exe tcp {port}"/>
                                <TextBlock Style="{StaticResource Label}" Text="Address pattern (optional, a regular expression)"/>
                                <TextBox x:Name="CustomPatternBox" FontFamily="Consolas"/>
                                <TextBlock Style="{StaticResource Help}" Text="Leave empty to use the first host:port the program prints."/>
                            </StackPanel>

                            <StackPanel x:Name="NgrokPanel">
                                <TextBlock Style="{StaticResource Label}" Text="ngrok authtoken (shared by all servers)"/>
                                <PasswordBox x:Name="NgrokTokenBox"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Help}" Margin="0,14,0,0" Text="Changes apply the next time the server starts."/>
                            <Button Content="Save" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Save_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="Server" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Style="{StaticResource Label}" Text="Name"/>
                            <TextBox x:Name="NameBox"/>

                            <TextBlock Style="{StaticResource Label}" Text="Memory (MB)"/>
                            <TextBox x:Name="RamBox" Width="120" HorizontalAlignment="Left"/>

                            <TextBlock Style="{StaticResource Label}" Text="Port"/>
                            <TextBox x:Name="PortBox" Width="120" HorizontalAlignment="Left"/>

                            <TextBlock Style="{StaticResource Label}" Text="Java"/>
                            <ComboBox x:Name="JavaBox"/>

                            <CheckBox x:Name="RestartOnCrashBox" Margin="0,12,0,0" Content="Restart automatically if it crashes"
                                      ToolTip="Up to 3 times in 10 minutes. You get an alert by the clock either way."/>
                            <CheckBox x:Name="AutoStartBox" Margin="0,6,0,0" Content="Start this server when MineServers opens"
                                      ToolTip="Turn on &quot;Start MineServers with Windows&quot; in App settings too, to have it running after every restart of the PC."/>
                            <CheckBox x:Name="AikarBox" Margin="0,6,0,0" Content="Use recommended Java settings for smoother play (Aikar's flags)"
                                      ToolTip="Tuned memory settings most server hosts use; fewer lag spikes. Applies at the next start."/>

                            <TextBlock Style="{StaticResource Label}" Text="Server icon (shown in the server list)"/>
                            <StackPanel Orientation="Horizontal">
                                <Border BorderBrush="#DDD" BorderThickness="1" Width="66" Height="66" Background="White">
                                    <Image x:Name="IconImage" Width="64" Height="64"/>
                                </Border>
                                <Button Content="Choose picture..." Margin="10,0,0,0" VerticalAlignment="Center" Click="Icon_Click"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Help}" Text="Any picture works: it's cropped to a square and shrunk to 64×64. Players see it after the next restart."/>

                            <TextBlock Style="{StaticResource Label}" Text="Upgrade to a newer Minecraft version"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="UpgradeBox" Width="160" DropDownOpened="UpgradeBox_DropDownOpened"/>
                                <Button x:Name="UpgradeButton" Content="Upgrade" Margin="6,0,0,0" Click="Upgrade_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="UpgradeHelp" Style="{StaticResource Help}"/>

                            <tabs:GameSettingsPanel x:Name="GamePanel"/>

                            <TextBlock Style="{StaticResource Help}" Margin="0,14,0,0"
                                       Text="Server and game settings apply when the server (re)starts. Game rules change instantly."/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Save" Style="{StaticResource Primary}" Click="Save_Click"/>
                                <Button Content="Remove from list" Click="Remove_Click"
                                        ToolTip="Takes the server off this list. Its folder and world are not deleted."/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Server Files">
                    <tabs:FilesTab x:Name="FileTab"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
