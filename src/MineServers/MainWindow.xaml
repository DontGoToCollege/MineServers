<Window x:Class="MineServers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MineServers" Width="1100" Height="720" MinWidth="800" MinHeight="500"
        Background="#F3F4F6" WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Server list -->
        <DockPanel Background="#1F2937">
            <TextBlock DockPanel.Dock="Top" Text="MineServers" Foreground="White" FontSize="22" FontWeight="Bold" Margin="16,16,16,12"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="12">
                <Button Content="+ New server" Style="{StaticResource Primary}" Margin="0,0,0,6" Click="NewServer_Click"/>
                <Button Content="Import from SquidServers" Margin="0" Click="Import_Click"/>
            </StackPanel>
            <ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0" Foreground="White"
                     SelectionChanged="ServerList_SelectionChanged" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,6">
                            <TextBlock Text="{Binding Entry.Name}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#555"
                   TextAlignment="Center" Text="No server selected.&#x0a;Make one with &quot;+ New server&quot;, or import your SquidServers servers."/>

        <!-- Selected server -->
        <Grid x:Name="DetailPanel" Grid.Column="1" Margin="20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Content="Start" Style="{StaticResource Primary}" Click="Start_Click"/>
                    <Button x:Name="StopButton" Content="Stop" Click="Stop_Click"/>
                    <Button Content="Open folder" Margin="0" Click="OpenFolder_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="NameText" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="InfoText" Foreground="#555"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12" Margin="0,14,0,10" BorderBrush="#DDD" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Join address:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button DockPanel.Dock="Right" Content="Copy" Margin="8,0,0,0" Click="Copy_Click"/>
                    <TextBox x:Name="AddressBox" IsReadOnly="True" FontSize="15" FontFamily="Consolas" VerticalContentAlignment="Center" BorderThickness="0"/>
                </DockPanel>
            </Border>

            <TabControl Grid.Row="2">
                <TabItem Header="Console">
                    <DockPanel Margin="6">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Send" Margin="6,0,0,0" Click="Send_Click"/>
                            <TextBox x:Name="CommandBox" FontFamily="Consolas" VerticalContentAlignment="Center" KeyDown="CommandBox_KeyDown"
                                     ToolTip="Type a server command (without /) and press Enter, e.g. op YourName"/>
                        </DockPanel>
                        <TextBox x:Name="ConsoleBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#111827" Foreground="#E5E7EB"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Players">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                            <CheckBox x:Name="WhitelistBox" Content="Whitelist: only players I've allowed can join" FontWeight="SemiBold"
                                      Click="WhitelistBox_Click"/>
                            <TextBlock Style="{StaticResource Help}"
                                       Text="When someone who isn't allowed tries to join, MineServers asks whether to let them in. Say yes once and they can always join this server."/>

                            <TextBlock x:Name="PlayersNote" Style="{StaticResource Help}" Foreground="#B45309" Margin="0,10,0,0"
                                       Text="Start the server to add, remove, ban or unban players."/>

                            <TextBlock Style="{StaticResource Label}" Text="Player name"/>
                            <TextBox x:Name="PlayerNameBox" Width="220" HorizontalAlignment="Left"/>

                            <TextBlock Style="{StaticResource Label}" Text="Allowed players (whitelist)"/>
                            <ListBox x:Name="AllowedList" Height="120"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Allow name" Click="AllowPlayer_Click"/>
                                <Button Content="Remove selected" Click="RemoveAllowed_Click"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Label}" Text="Banned players"/>
                            <ListBox x:Name="BannedList" Height="120"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Ban name" Click="BanPlayer_Click"/>
                                <Button Content="Unban selected" Click="Unban_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Label}" Text="Name"/>
                            <TextBox x:Name="NameBox"/>

                            <TextBlock Style="{StaticResource Label}" Text="Tunnel (how friends outside your Wi-Fi join)"/>
                            <ComboBox x:Name="TunnelBox" SelectionChanged="TunnelBox_SelectionChanged"/>
                            <TextBlock x:Name="TunnelHelp" Style="{StaticResource Help}"/>

                            <StackPanel x:Name="CustomPanel">
                                <TextBlock Style="{StaticResource Label}" Text="Custom tunnel command"/>
                                <TextBox x:Name="CustomCommandBox" FontFamily="Consolas"/>
                                <TextBlock Style="{StaticResource Help}" Text="Example: C:\Tools\mytunnel.exe tcp {port}"/>
                                <TextBlock Style="{StaticResource Label}" Text="Address pattern (optional, a regular expression)"/>
                                <TextBox x:Name="CustomPatternBox" FontFamily="Consolas"/>
                                <TextBlock Style="{StaticResource Help}" Text="Leave empty to use the first host:port the program prints."/>
                            </StackPanel>

                            <StackPanel x:Name="NgrokPanel">
                                <TextBlock Style="{StaticResource Label}" Text="ngrok authtoken (shared by all servers)"/>
                                <PasswordBox x:Name="NgrokTokenBox"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Label}" Text="Memory (MB)"/>
                            <TextBox x:Name="RamBox" Width="120" HorizontalAlignment="Left"/>

                            <TextBlock Style="{StaticResource Label}" Text="Port"/>
                            <TextBox x:Name="PortBox" Width="120" HorizontalAlignment="Left"/>

                            <TextBlock Style="{StaticResource Label}" Text="Java"/>
                            <ComboBox x:Name="JavaBox"/>

                            <TextBlock Style="{StaticResource Help}" Margin="0,14,0,0" Text="Changes apply the next time the server starts."/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Save" Style="{StaticResource Primary}" Click="Save_Click"/>
                                <Button Content="Remove from list" Click="Remove_Click"
                                        ToolTip="Takes the server off this list. Its folder and world are not deleted."/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
