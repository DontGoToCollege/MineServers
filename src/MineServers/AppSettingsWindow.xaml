<Window x:Class="MineServers.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App settings" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18">
        <CheckBox x:Name="StartupBox" Content="Start MineServers when Windows starts (hidden by the clock)"/>
        <TextBlock Style="{StaticResource Help}" Text="Servers set to &quot;Start this server when MineServers opens&quot; (Settings tab) then start too."/>

        <CheckBox x:Name="TrayBox" Margin="0,12,0,0" Content="Minimizing hides MineServers by the clock"/>
        <TextBlock Style="{StaticResource Help}" Text="Servers keep running. Double-click the MineServers icon by the clock to bring it back."/>

        <CheckBox x:Name="JoinsBox" Margin="0,12,0,0" Content="Show an alert when someone joins"/>

        <TextBlock Style="{StaticResource Label}" Margin="0,16,0,3" Text="Discord webhook link (optional)"/>
        <TextBox x:Name="WebhookBox"/>
        <TextBlock Style="{StaticResource Help}"
                   Text="Posts to a Discord channel when a server starts (with its join address), stops or crashes, and when players join or leave. In Discord: channel settings &gt; Integrations &gt; Webhooks &gt; New Webhook &gt; Copy Webhook URL."/>
        <Button Content="Send a test message" HorizontalAlignment="Left" Margin="0,6,0,0" Click="Test_Click"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Save" Style="{StaticResource Primary}" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Margin="0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
