<UserControl x:Class="MineServers.Tabs.FilesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <!-- Browser -->
        <DockPanel x:Name="Browser">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Up" Click="Up_Click"/>
                    <Button Content="Refresh" Click="Refresh_Click"/>
                    <Button Content="Open in Explorer" Margin="0" Click="Explorer_Click"/>
                </StackPanel>
                <TextBlock x:Name="PathText" VerticalAlignment="Center" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Help}"
                       Text="Double-click a folder to open it, or a file to edit it here (text files) or open it with its program."/>
            <ListBox x:Name="EntryList" FontFamily="Consolas" MouseDoubleClick="EntryList_MouseDoubleClick" KeyDown="EntryList_KeyDown"/>
        </DockPanel>

        <!-- Editor -->
        <DockPanel x:Name="EditorPanel" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Save" Style="{StaticResource Primary}" Click="Save_Click"/>
                    <Button Content="Close" Margin="0" Click="Close_Click"/>
                </StackPanel>
                <TextBlock x:Name="EditingText" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock x:Name="RunningWarning" DockPanel.Dock="Top" Style="{StaticResource Help}" Foreground="#B45309" Margin="0,0,0,6"
                       Text="The server is running. It reads most config files only when it starts, and may overwrite some of them, so stop it before editing configs."/>
            <TextBox x:Name="EditorBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</UserControl>
