<UserControl x:Class="MineServers.Tabs.SchedulerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,14,0">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="+ New task" Margin="0,0,0,6" Click="New_Click"/>
                <ComboBox x:Name="TemplateBox" SelectionChanged="TemplateBox_SelectionChanged"/>
                <TextBlock Style="{StaticResource Help}" Text="Pick a ready-made task above to add it."/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="Tasks" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ListBox x:Name="TaskList" SelectionChanged="TaskList_SelectionChanged"/>
        </DockPanel>

        <TextBlock x:Name="NoTaskText" Grid.Column="1" TextWrapping="Wrap" Foreground="#555" FontSize="14"
                   Text="No tasks yet. Click &quot;+ New task&quot;, or pick a ready-made one like a daily restart or auto-save."/>
        <ScrollViewer x:Name="EditorScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Editor" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,3" Text="Name"/>
                <TextBox x:Name="NameBox"/>
                <CheckBox x:Name="EnabledBox" Content="On" Margin="0,8,0,0"/>

                <TextBlock Style="{StaticResource Label}" Text="When"/>
                <ComboBox x:Name="KindBox" SelectionChanged="KindBox_SelectionChanged">
                    <ComboBoxItem Tag="interval" Content="Every few minutes"/>
                    <ComboBoxItem Tag="daily" Content="Every day at a time"/>
                    <ComboBoxItem Tag="weekly" Content="Every week on a day and time"/>
                </ComboBox>
                <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="IntervalBox" Width="70"/>
                    <TextBlock Text="minutes" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="TimePanel" Orientation="Horizontal" Margin="0,6,0,0">
                    <ComboBox x:Name="DayBox" Width="120" Margin="0,0,8,0"/>
                    <TextBlock Text="at" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TimeBox" Width="70" ToolTip="24-hour time, e.g. 04:00 or 21:30"/>
                    <TextBlock Text="(24-hour, e.g. 04:00)" Foreground="#555" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Label}" Text="What to do (one step per line)"/>
                <TextBox x:Name="CommandsBox" AcceptsReturn="True" FontFamily="Consolas" Height="130" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Style="{StaticResource Help}">
                    Any server command (say Hello, save-all, weather clear...), plus:<LineBreak/>
                    !wait 30 · pause for 30 seconds<LineBreak/>
                    !restart · stop and start the server<LineBreak/>
                    !start · start it if it's stopped<LineBreak/>
                    !stop · stop it (saving the world first)
                </TextBlock>
                <TextBlock x:Name="LastRunText" Style="{StaticResource Help}" Margin="0,8,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Save" Style="{StaticResource Primary}" Click="Save_Click"/>
                    <Button Content="Run now" Click="RunNow_Click"/>
                    <Button Content="Delete" Click="Delete_Click"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Help}" Margin="0,8,0,0"
                           Text="Tasks run while MineServers is open. Commands are skipped while the server is stopped (except !start)."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
