<UserControl x:Class="MineServers.Tabs.WorldTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Backups" FontWeight="Bold" FontSize="15"/>
            <TextBlock Style="{StaticResource Help}"
                       Text="A backup is a copy of the whole server: world, settings and plugins or mods. It works while the server runs too (the world is saved first)."/>
            <ListBox x:Name="BackupList" Height="150" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="BackupButton" Content="Back up now" Style="{StaticResource Primary}" Click="Backup_Click"/>
                <Button Content="Restore selected" Click="Restore_Click"/>
                <Button Content="Delete selected" Click="Delete_Click"/>
                <Button Content="Open backups folder" Click="OpenBackups_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Keep the last" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="KeepBox" Width="50" LostFocus="KeepBox_LostFocus"/>
                <TextBlock Text="backups (older ones are deleted)" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Help}"
                       Text="To back up automatically, add a Scheduler task with the step !backup (there's a ready-made one). Backups made before a restore or world change are kept until you delete them."/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Help}" Foreground="#2E7D32" Margin="0,8,0,0"/>

            <TextBlock Text="World" FontWeight="Bold" FontSize="15" Margin="0,22,0,0"/>
            <Button Content="Download world (zip)" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Download_Click"
                    ToolTip="Saves a copy of the world as a zip, to share or use somewhere else."/>
            <TextBlock x:Name="StoppedNote" Style="{StaticResource Help}" Foreground="#B45309" Margin="0,12,0,0"
                       Text="Stop the server to replace or reset the world."/>
            <TextBlock Style="{StaticResource Help}" Margin="0,8,0,0"
                       Text="Each of these makes a backup first, so you can always go back."/>

            <TextBlock Style="{StaticResource Label}" Text="Replace the world"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ZipButton" Content="From a zip..." Click="ReplaceZip_Click"/>
                <Button x:Name="FolderButton" Content="From a world folder..." Click="ReplaceFolder_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Help}" Text="Use a world from another server, or one of your singleplayer worlds (they're in .minecraft\saves)."/>

            <TextBlock Style="{StaticResource Label}" Text="Reset part of the world"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="NetherButton" Content="Reset the Nether" Click="ResetNether_Click"/>
                <Button x:Name="EndButton" Content="Reset the End" Click="ResetEnd_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Help}" Text="It's made fresh the next time the server starts. The Overworld isn't touched."/>

            <TextBlock Style="{StaticResource Label}" Text="Start a new world"/>
            <DockPanel>
                <Button x:Name="NewWorldButton" DockPanel.Dock="Right" Content="Make new world" Margin="6,0,0,0" Click="NewWorld_Click"/>
                <TextBox x:Name="SeedBox" VerticalContentAlignment="Center" ToolTip="Seed (leave empty for a random one)"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Help}" Text="Type a seed, or leave it empty for a random world."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
