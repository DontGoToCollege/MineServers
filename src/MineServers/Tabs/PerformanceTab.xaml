<UserControl x:Class="MineServers.Tabs.PerformanceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="CPU" Foreground="#555"/>
                    <TextBlock x:Name="CpuText" FontSize="22" FontWeight="Bold" Text="-"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Memory" Foreground="#555"/>
                    <TextBlock x:Name="MemText" FontSize="22" FontWeight="Bold" Text="-"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Players online" Foreground="#555"/>
                    <TextBlock x:Name="PlayersText" FontSize="22" FontWeight="Bold" Text="-"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Running for" Foreground="#555"/>
                    <TextBlock x:Name="UptimeText" FontSize="22" FontWeight="Bold" Text="-"/>
                </StackPanel>
            </UniformGrid>

            <TextBlock Style="{StaticResource Label}" Text="CPU (last 10 minutes)"/>
            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Height="110">
                <Canvas x:Name="CpuChart" ClipToBounds="True" SizeChanged="Chart_SizeChanged">
                    <Polyline x:Name="CpuLine" Stroke="#2E7D32" StrokeThickness="2"/>
                </Canvas>
            </Border>

            <TextBlock Style="{StaticResource Label}" Text="Memory (last 10 minutes)"/>
            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Height="110">
                <Canvas x:Name="MemChart" ClipToBounds="True" SizeChanged="Chart_SizeChanged">
                    <Polyline x:Name="MemLine" Stroke="#1565C0" StrokeThickness="2"/>
                </Canvas>
            </Border>

            <TextBlock Style="{StaticResource Label}" Text="Lag check"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Measure tick time" Click="Measure_Click"/>
                <TextBlock x:Name="TickText" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Help}"
                       Text="The server does a 'tick' 20 times a second, so each tick has 50 ms. Under 50 ms means no lag; over 50 ms, things slow down. Lowering view or simulation distance (Settings) helps most."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
