<Window x:Class="MineServers.NewServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New server" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded">
    <StackPanel Margin="18">
        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,3" Text="Name"/>
        <TextBox x:Name="NameBox" Text="My Server"/>

        <TextBlock Style="{StaticResource Label}" Text="Type"/>
        <ComboBox x:Name="TypeBox" SelectedIndex="0">
            <ComboBoxItem Tag="vanilla" Content="Vanilla (plain Minecraft)"/>
            <ComboBoxItem Tag="paper" Content="Paper (faster, supports plugins)"/>
            <ComboBoxItem Tag="fabric" Content="Fabric (supports mods)"/>
        </ComboBox>

        <TextBlock Style="{StaticResource Label}" Text="Minecraft version"/>
        <ComboBox x:Name="VersionBox"/>

        <TextBlock Style="{StaticResource Label}" Text="Memory (MB)"/>
        <TextBox x:Name="RamBox" Width="120" HorizontalAlignment="Left"/>

        <CheckBox x:Name="EulaBox" Margin="0,16,0,0">
            <TextBlock TextWrapping="Wrap">
                I agree to the <Hyperlink NavigateUri="https://aka.ms/MinecraftEULA" RequestNavigate="Eula_RequestNavigate">Minecraft EULA</Hyperlink>
            </TextBlock>
        </CheckBox>

        <TextBlock x:Name="StatusText" Style="{StaticResource Help}" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CreateButton" Content="Create" Style="{StaticResource Primary}" Click="Create_Click" IsDefault="True"/>
            <Button Content="Cancel" Margin="0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
